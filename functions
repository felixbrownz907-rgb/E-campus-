export async function onRequestPost(context) {

    try {

        const { topic, questionType, examType, numQuestions } = await context.request.json();

        if (!topic) {
            return new Response(JSON.stringify({ error: "Topic is required" }), { status: 400 });
        }

        const apiKey = context.env.GEMINI_API_KEY;

        if (!apiKey) {
            return new Response(JSON.stringify({ error: "AI service not configured" }), { status: 500 });
        }

        const count = numQuestions || 5;

        let formatInstructions = "";

        if (questionType === "true_false") {
            formatInstructions = `Generate exactly ${count} TRUE/FALSE questions. For each question, respond in this exact format, one question per block, separated by a blank line:

Q: [question text]
A) True
B) False
ANSWER: [A or B]`;
        } else {
            formatInstructions = `Generate exactly ${count} multiple choice questions with 4 options each. For each question, respond in this exact format, one question per block, separated by a blank line:

Q: [question text]
A) [option]
B) [option]
C) [option]
D) [option]
ANSWER: [correct letter]`;
        }

        const prompt = `You are an experienced university lecturer preparing a ${examType || "quiz"} for the topic: "${topic}".

${formatInstructions}

Only output the questions in the exact format shown. Do not include any introduction, explanation, or extra text before or after the questions.`;

        const geminiResponse = await fetch(
            `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${apiKey}`,
            {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                    contents: [{ parts: [{ text: prompt }] }]
                })
            }
        );

        const geminiData = await geminiResponse.json();

        if (!geminiResponse.ok) {
            return new Response(JSON.stringify({ error: geminiData.error?.message || "AI request failed" }), { status: 500 });
        }

        const generatedText = geminiData.candidates?.[0]?.content?.parts?.[0]?.text || "";

        return new Response(JSON.stringify({ text: generatedText }), {
            headers: { "Content-Type": "application/json" }
        });

    } catch (err) {

        return new Response(JSON.stringify({ error: err.message }), { status: 500 });

    }

}
